      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#calculator\" aria-current=\"page\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8M8 11h1m3 0h1m3 0h.1M8 15h1m3 0h1m3 0h.1M8 18h1m3 0h1m3 0h.1\"/></svg>Calculator</a><a href=\"#guide\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v15M12 5C8 2 4 3 2 4v15c4-2 7-1 10 1 3-2 6-3 10-1V4c-2-1-6-2-10 1Z\"/></svg>How it works</a></nav>",
      "css": ".ds-nav{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:6px;background:#f0eff7;padding:12px;}.ds-nav a{display:flex;align-items:center;gap:12px;padding:13px 12px;border-radius:8px;text-decoration:none;color:#625e77;font-size:12px;font-weight:650;min-height:46px;}.ds-nav a:hover{background:#e7e3f4;color:#4f4594;}.ds-nav a[aria-current=page]{color:#5748b5;background:#e3def6;}.ds-nav a:focus-visible{outline:3px solid #9587ec;outline-offset:3px;}.ds-nav-icon{width:18px;height:18px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}.ds-nav a[aria-current=page] .ds-nav-icon{stroke-width:2;}"
    },
    {
      "name": "Rule Chip",
      "kind": "chip",
      "refersTo": "rule-chip",
      "description": "Non-interactive plan-rule context beside account details.",
      "html": "<span class=\"ds-rule-chip\">35% consistency rule</span>",
      "css": ".ds-rule-chip{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:inline-block;font-size:12px;color:#6252b6;background:#f1edfc;border:1px solid #e5def7;padding:5px 9px;border-radius:5px;font-weight:700;}"
    },
    {
      "name": "Work Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white work area with a quiet border and softly rounded edge.",
      "html": "<section class=\"ds-panel\"><h2>Your trading performance</h2><p>Enter your profit for the current calculation window.</p></section>",
      "css": ".ds-panel{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--white,#fff);border:1px solid var(--line,#e9e9f0);border-radius:var(--radius,14px);padding:25px 26px 19px;color:var(--ink,#282735);}.ds-panel h2{font-size:15px;font-weight:750;margin:0;letter-spacing:-.025em;line-height:1.5;}.ds-panel p{font-size:12px;color:var(--muted,#6c6b7d);line-height:1.7;}"
    },
    {
      "name": "Input Mode Selector",
      "kind": "custom",
      "description": "Two pressed-state buttons on a quiet segmented bed.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Input method\"><button aria-pressed=\"true\">Quick calculation</button><button aria-pressed=\"false\">Daily P&amp;L</button></div>",
      "css": ".ds-segmented{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:flex;padding:4px;background:#f4f4f8;border-radius:8px;gap:4px;}.ds-segmented button{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;width:50%;padding:9px 5px;background:transparent;border:0;border-radius:5px;color:#70647e;font-size:12px;font-weight:650;display:flex;align-items:center;justify-content:center;gap:7px;min-height:34px;cursor:pointer;}.ds-segmented button[aria-pressed=true]{background:#fff;color:#51476f;box-shadow:0 1px 5px #28243f0c;}.ds-segmented button:hover{color:var(--purple,#6056ce);}.ds-segmented button:focus-visible{outline:3px solid #9587ec;outline-offset:3px;}"
    },
    {
      "name": "Consistency Meter",
      "kind": "custom",
      "refersTo": "result-panel",
      "description": "A violet share, dashed threshold, and written quantitative context.",
      "html": "<section class=\"ds-result\"><h2>Your consistency</h2><div class=\"ds-ratio\">42.86<small>%</small></div><p class=\"ds-ratio-description\">of your profit came from your best trading day</p><div class=\"ds-meter\" style=\"--share:42.86%;--limit:35%\" role=\"img\" aria-label=\"Best-day share 42.86 percent, limit 35 percent\"><span class=\"ds-meter-fill\"></span><span class=\"ds-meter-limit\"></span></div><div class=\"ds-meter-labels\"><span>0%</span><span>100%</span></div><p class=\"ds-meter-legend\"><span></span>35% consistency limit</p></section>",
      "css": ".ds-result{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f0edfb;border:1px solid #e6dff5;border-radius:var(--radius,14px);padding:25px 27px;color:#49405f;min-width:0;}.ds-result h2{font-size:15px;font-weight:750;margin:0;letter-spacing:-.025em;line-height:1.5;}.ds-ratio{font-size:57px;letter-spacing:-.04em;font-weight:750;line-height:1.2;margin:21px 0 4px;color:#494061;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}.ds-ratio small{font-size:30px;margin-left:3px;font-weight:600;}.ds-ratio-description{font-size:12px;color:#70647e;margin:0 0 24px;}.ds-meter{position:relative;height:10px;background:#e0d9ee;border-radius:4px;margin-top:15px;}.ds-meter-fill{display:block;background:#8d7ac9;height:100%;width:var(--share);max-width:100%;border-radius:4px;transition:width 180ms ease-out;}.ds-meter-limit{position:absolute;left:var(--limit);top:-6px;height:22px;border-left:2px dashed #7a6b98;}.ds-meter-labels{display:flex;justify-content:space-between;font-size:12px;color:#70647e;margin-top:12px;}.ds-meter-legend{display:flex;align-items:center;gap:5px;font-size:12px;color:#70647e;margin-top:12px;}.ds-meter-legend span{height:11px;border-left:2px dashed #7a6b98;margin-right:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-field,.ds-meter-fill,.ds-strip>span{transition:none!important;}}"
    },
    {
      "name": "Best-Day Profit Strip",
      "kind": "custom",
      "description": "Related violet tones show best-day profit and the remaining share.",
      "html": "<div class=\"ds-strip\" role=\"img\" aria-label=\"Best day 1200 dollars, other profit 1600 dollars\"><span class=\"ds-best\" style=\"width:42.86%\"></span><span class=\"ds-rest\" style=\"width:57.14%\"></span></div><div class=\"ds-strip-legend\"><span><i></i>Best day</span><span><i class=\"ds-rest-dot\"></i>All other days, net</span></div>",
      "css": ".ds-strip{display:flex;height:27px;border-radius:5px;overflow:hidden;margin:18px 0 10px;background:#f0ecf7;}.ds-strip>span{transition:width 180ms ease-out;}.ds-best{background:#8f7acb;}.ds-rest{background:#dcd3ee;}.ds-strip-legend{font-family:Manrope,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:flex;justify-content:space-between;gap:10px;font-size:12px;color:#70647e;}.ds-strip-legend>span{display:flex;align-items:center;gap:5px;}.ds-strip-legend i{width:7px;height:7px;background:#8f7acb;border-radius:2px;}.ds-strip-legend .ds-rest-dot{background:#dcd3ee;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-field,.ds-meter-fill,.ds-strip>span{transition:none!important;}}"
    }
  ],
  "narrative": {
    "northStar": "The Investment Research Desk",
    "overview": "Consistency uses a cool, light workspace with a lavender navigation rail, white work areas, and a violet result surface. The visual character is calm and compact: the work is choosing a precise account and understanding a number, so selection, input, and calculated evidence carry the emphasis.\n\nThis records the implemented source in `index.html`, `styles.css`, and `src/app.js`, informed by `PRODUCT.md` and the surface direction. The named world describes the code-led direction assumed during implementation; it is not a claim of an explicit user selection. Desktop and mobile screenshots were unavailable, so visual verification and final acceptance remain incomplete. The system is light-only in the current source.",
    "keyCharacteristics": [
      "Tonal lavender separation between navigation, editable work, and calculated results.",
      "One sans-serif family, compact labels, and tabular financial figures.",
      "Quiet borders, gently rounded containers, and sparse shadows.",
      "Accessible HTML, CSS, and inline SVG rather than shipping raster imagery."
    ],
    "rules": [
      {
        "name": "The Result Wash Rule",
        "body": "Use the tinted result surface to distinguish calculated evidence from white editable work areas.",
        "section": "colors"
      },
      {
        "name": "The Stable Figures Rule",
        "body": "Keep financial values tabular in inputs, ratios, scenario values, and tables so numerical changes preserve alignment.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal fill and borders for normal panel separation; preserve shadows for selected segments and transient overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the tinted result surface to separate calculated evidence from editable white work areas.",
      "Do keep financial figures tabular and preserve their written labels, formula, and status context.",
      "Do retain keyboard focus treatments and use written status alongside state color.",
      "Do respect the source responsive transitions from a rail to a sticky top navigation bar.",
      "Do label source-only design documentation and unresolved rendered verification honestly."
    ],
    "donts": [
      "Don't equate a successful consistency badge with full payout or funded-account eligibility.",
      "Don't make a normal work panel visually elevated with the toast shadow.",
      "Don't introduce automatic entrance motion; the implemented motion is limited to changing state and data.",
      "Don't treat the absence of desktop and mobile screenshots as completed visual acceptance."
    ]
  }
}
